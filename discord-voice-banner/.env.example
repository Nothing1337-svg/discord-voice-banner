DISCORD_TOKEN=your-discord-bot-token
GUILD_ID=123456789012345678

# Set true only when the bot has Manage Server permission and the server supports banners.
APPLY_GUILD_BANNER=false

# Optional runtime tuning.
BANNER_PERIOD=all
UPDATE_INTERVAL_SECONDS=300
BANNER_UPDATE_COOLDOWN_SECONDS=20
DATABASE_PATH=data/voice_banner.sqlite3
BANNER_OUTPUT_PATH=data/current-banner.png
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

